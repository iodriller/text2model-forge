{
  "id": "footman",
  "source": "asset_sources/ember-defense/assets/footman/master/footman.blend",
  "max_polygons": 45000,
  "animation_object": "Armature",
  "cell_size": [256, 256],
  "render_size": [512, 512],
  "orthographic_scale": 4.6,
  "camera_target_height": 1.15,
  "camera_distance": 10.0,
  "camera_height": 7.0,
  "target_height_fraction": 0.78,
  "directions": ["north", "south", "east", "west"],
  "animations": {
    "idle": { "actions": ["idle", "Idle", "Standing Idle"], "frames": 4, "loop": true },
    "walk": { "actions": ["walk", "Walk", "Walking"], "frames": 6, "loop": true },
    "attack": { "actions": ["attack", "Attack", "Sword And Shield Slash"], "frames": 6, "loop": false },
    "hit": { "actions": ["hit", "Hit", "Taking Damage"], "frames": 2, "loop": false },
    "death": { "actions": ["death", "Death", "Dying"], "frames": 6, "loop": false }
  },
  "output_path_pattern": "unity/EmberDefenseUnity/Assets/Art/Characters/footman/footman_{animation}_{direction}_sheet.png"
}
