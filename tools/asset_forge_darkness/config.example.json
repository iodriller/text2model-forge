      ],
      "environment": {
        "DARKNESS_TRIPOSG_SOURCE": "C:/path/to/TripoSG",
        "DARKNESS_TRIPOSG_WEIGHTS": "C:/path/to/TripoSG/pretrained_weights/TripoSG",
