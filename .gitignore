# Machine-local config: real binary paths and env vars, never portable.
config.local.toml
config.local.json
# The container sample has no machine paths or credentials and is intentionally
# versioned; only the repository-root machine config stays ignored.
!docker/config.local.toml

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Vendored/generated ComfyUI-style runtime and downloaded model weights, if
# a worker environment is ever set up alongside the repo instead of outside it.
runtime/
workspaces/
*.safetensors
*.ckpt
*.pt
*.onnx

# Local run output, never checked in.
/AssetForgeRuns/
/VettedMeshRuns/

# Machine-local recovery notes produced while repairing a ComfyUI install.
/.comfyui-revert-to.txt
/.comfyui-torch-before.txt
/motion_library/catalog.json
