{
  "id": "humanoid_template",
  "source": "artifacts/vettedmesh-template/source/humanoid_template.blend",
  "animation_object": "Armature",
  "cell_size": [128, 128],
  "render_size": [256, 256],
  "orthographic_scale": 4.6,
  "camera_target_height": 1.2,
  "camera_distance": 10.0,
  "camera_height": 7.0,
  "target_height_fraction": 0.78,
  "directions": ["north", "south", "east", "west"],
  "animations": {
    "idle": { "actions": ["idle"], "frames": 4, "loop": true },
    "walk": { "actions": ["walk"], "frames": 6, "loop": true },
    "attack": { "actions": ["attack"], "frames": 6, "loop": false },
    "shoot": { "actions": ["shoot"], "frames": 6, "loop": false },
    "hit": { "actions": ["hit"], "frames": 2, "loop": false },
    "death": { "actions": ["death"], "frames": 6, "loop": false }
  },
  "output_path_pattern": "artifacts/vettedmesh-template/sheets/humanoid_template_{animation}_{direction}_sheet.png"
}
